PORT=3000
HOST=127.0.0.1
# Set OWNER_EMAIL on non-Codespaces hosts before creating the first account.
# A private Codespaces launch bootstraps its owner through the private GitHub gateway.
OWNER_EMAIL=
# New accounts require an administrator invitation by default.
ALLOW_SIGNUP=false
# Browser agent: any OpenAI-compatible chat/completions model with JSON mode
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# Coding agent: leave blank to reuse the browser's connection
CODE_BASE_URL=
CODE_MODEL=
CODE_API_KEY=
# Optional native provider ID (e.g. anthropic or openrouter).
# Leave blank to use the OpenAI-compatible streaming adapter.
CODE_PROVIDER_ID=
# Optional internal service key; the full IDE launcher creates a private key in DATA_DIR if omitted.
WEB_AGENT_TOKEN=
MAX_CONCURRENCY=2
# Only enable on a dedicated trusted worker or sandboxed container.
# Project test/build code executes on that worker, with explicit approval.
ENABLE_PROJECT_COMMANDS=false
# Optional alternate Chromium binary on your host
# CHROMIUM_EXECUTABLE_PATH=/path/to/chromium
