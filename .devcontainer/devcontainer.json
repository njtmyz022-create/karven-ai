{
  "name": "KARVIN IDE",
  "build": {
    "dockerfile": "../karvin-ide/Dockerfile.ide",
    "context": ".."
  },
  "overrideCommand": true,
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "KARVIN IDE",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "cd karvin-ide && ln -sfn /app/node_modules node_modules && ln -sfn /app/.runtime .runtime",
  "postStartCommand": "cd karvin-ide && ln -sfn /app/node_modules node_modules && ln -sfn /app/.runtime .runtime && node ../.devcontainer/start-karvin.mjs",
  "shutdownAction": "stopContainer",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  }
}
